<server>
    <variable name="JDBC_SSL" defaultValue="false"/>
    <dataSource id="PortfolioDB" jndiName="jdbc/Portfolio/PortfolioDB" connectionManagerRef="dbConnections" type="javax.sql.ConnectionPoolDataSource" transactional="true" isolationLevel="TRANSACTION_REPEATABLE_READ">
        <jdbcDriver javax.sql.ConnectionPoolDataSource="org.postgresql.ds.PGConnectionPoolDataSource">
            <library name="Postgres" description="PostgreSQL and Azure Identity JDBC driver jars">
                
                <fileset dir="/config/prereqs" includes="*.jar"/>
                
            </library>
        </jdbcDriver>
        
        <properties.postgresql  
            URL="jdbc:postgresql://${env.JDBC_HOST}:${env.JDBC_PORT}/${env.JDBC_DB}?sslmode=require&amp;authenticationPluginClassName=com.azure.identity.extensions.jdbc.postgresql.AzurePostgresqlAuthenticationPlugin" 
            user="${env.JDBC_ID}" /> 
    </dataSource>
</server>
